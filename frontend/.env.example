# Leave both unset for normal local dev: requests go to /api and the Vite dev
# server proxies them to the Express API on http://localhost:4000.

# Override the proxy target if you run the API on a different port.
# VITE_PROXY_TARGET=http://localhost:4000

# Set this only for a deployed build, where there is no dev-server proxy and the
# client must call the API by absolute URL, e.g. https://erp-api.onrender.com/api
# VITE_API_BASE_URL=
