# Port 5433 matches docker-compose.yml at the repo root (5432 is left free for
# any Postgres you already run locally).
DATABASE_URL="postgresql://sms:sms_dev_password@localhost:5433/sms?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000
# Must match the Vite dev server origin. Only matters for direct browser->API
# calls; during normal dev the Vite proxy makes requests same-origin.
CORS_ORIGIN="http://localhost:5173"
SEED_RESET="true"

# Natural-language student search (Phase 3). LLM_PROVIDER picks which one is active -- only
# that provider's key needs to be set. Leaving the active one unset doesn't crash the server;
# POST /api/students/search-nl returns a clean 500 instead, and the startup log warns loudly.
LLM_PROVIDER="groq"   # "groq" | "gemini" -- defaults to groq if unset

# Groq: free key from https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Gemini: free key (no credit card) from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
